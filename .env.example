# ── App ──────────────────────────────────────
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Supabase (Database, Auth, Vector Store) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── LLM Providers ─────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=            # optional, add later if used
# ANTHROPIC_API_KEY=         # optional, add later if used

# ── Web Search Tool ───────────────────────────
SEARCH_API_KEY=your-tavily-or-serpapi-key

# ── Voice (Phase 4) ───────────────────────────
PICOVOICE_ACCESS_KEY=your-picovoice-key
# ELEVENLABS_API_KEY=        # optional, only if you upgrade from Edge-TTS

# ── Security ──────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-long-random-string

# ── Monitoring (Phase 8) ──────────────────────
# SENTRY_DSN=

