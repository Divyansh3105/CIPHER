# ── App ──────────────────────────────────────
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase (Database, Auth, Vector Store) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Request-time connection. If your project uses Supavisor, this should be
# the *transaction-mode* pooler (port 6543) -- see services/backend/app/core/database.py
# for why that requires disabling asyncpg's prepared-statement cache.
# NOTE: percent-encode any special characters in the password (e.g. `[` -> %5B).
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Used only for running Alembic migrations. Prefer a non-pooled/session-mode
# connection (Supavisor port 5432) since DDL doesn't play well with
# transaction-mode pooling. Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Backend Dev User (Phase 1 -- real auth not added yet) ──
# Every request is attributed to this single seeded user (see
# services/backend/app/api/deps.py and services/backend/scripts/seed_dev_user.py).
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ── LLM Providers ─────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=            # optional, add later if used
# ANTHROPIC_API_KEY=         # optional, add later if used

# ── Web Search Tool ───────────────────────────
SEARCH_API_KEY=your-tavily-or-serpapi-key

# ── Voice (Phase 4) ───────────────────────────
PICOVOICE_ACCESS_KEY=your-picovoice-key
# ELEVENLABS_API_KEY=        # optional, only if you upgrade from Edge-TTS

# ── Security ──────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-long-random-string

# ── Monitoring (Phase 8) ──────────────────────
# SENTRY_DSN=

