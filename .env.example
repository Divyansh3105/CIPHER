# CIPHER environment variables
#
# Copy to `.env` in this same directory (repo root -- both the backend and
# the frontend read from here) and fill in the REQUIRED block. Everything
# below that block is dead weight until the phase that needs it, so leave
# those keys at their placeholder values rather than hunting for accounts
# you don't need yet.
#
# Quick answer to "which keys do I still need?": if Phases 1-4 are all you
# are running, NONE. The required block below is complete as of Phase 4.
#
#   KEY                     COST    NEEDED FOR                       PHASE
#   ---------------------------------------------------------------------
#   DATABASE_URL            free    everything                       1  ✅
#   MIGRATION_DATABASE_URL  free    alembic migrations               1  ✅
#   SUPABASE_*              free    db / auth / pgvector             1  ✅
#   GEMINI_API_KEY          free    chat replies AND memory vectors  1,3 ✅
#   GROQ_API_KEY            free    fallback when Gemini fails       1  ✅
#   ---------------------------------------------------------------------
#   (no key)                free    voice in/out via the browser     4  ✅
#   (no key)                free    whisper STT, if you switch to it 4
#   (no key)                free    edge-tts, if you switch to it    4
#   PICOVOICE_ACCESS_KEY    free    "Hey CIPHER" wake word only      4
#   SEARCH_API_KEY          free    web search tool                  5
#   AUTH_DISABLED           n/a     preflight/curl without a login   8
#
# Phase 4 note: the shipped voice loop is the browser's Web Speech API
# (apps/web/src/lib/speech.ts). It is free, needs no account, and needs no
# key -- but it is Chrome/Edge-only and sends audio to Google. Whisper +
# Edge-TTS, the blueprint's local alternative, are also keyless: they cost a
# model download and CPU, not credentials. Nothing in Phase 4 requires you
# to sign up for anything.

# ── REQUIRED ─────────────────────────────────────────────────────────────

# App
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Frontend. Read by Next.js at build time; `NEXT_PUBLIC_` is what makes it
# visible to browser code, so never put a secret behind that prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Postgres + pgvector + auth). Free tier.
# Dashboard -> Project Settings -> API. SUPABASE_KEY is the ANON key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Request-time connection. If your project uses Supavisor, this should be
# the *transaction-mode* pooler (port 6543) -- see
# services/backend/app/core/database.py for why that requires disabling
# asyncpg's prepared-statement cache.
# NOTE: percent-encode any special characters in the password (e.g. `[` -> %5B).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Used only for running Alembic migrations. Prefer a non-pooled/session-mode
# connection (Supavisor port 5432) since DDL doesn't play well with
# transaction-mode pooling. Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgresql://user:password@host:5432/dbname

# LLM providers. Both free tier.
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
# GEMINI_API_KEY does double duty -- the same key generates Phase 3's
# gemini-embedding-001 vectors through the same google-genai client, so
# long-term memory needs no separate embedding key.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Auth is Supabase sign-in: the backend verifies each request's session token
# against SUPABASE_URL's public keys (services/backend/app/api/deps.py), so it
# needs no JWT secret. The frontend needs the URL and the ANON key too, in
# apps/web/.env.local (Next.js does not read this file):
#   NEXT_PUBLIC_SUPABASE_URL=<SUPABASE_URL>
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<the anon key, never the service_role key>
#
# AUTH_DISABLED=true lets a request with NO token act as the seeded dev user
# below -- what `python -m scripts.preflight` and curl need on your machine.
# A token that fails to verify is refused either way. NEVER set it on a
# hosted backend: anyone with the URL would get this user's data and your
# API quota.
AUTH_DISABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ── NOT NEEDED YET ───────────────────────────────────────────────────────
# Leave these as-is. Each is checked into the phase that introduces it, and
# nothing reads a placeholder value before then.

# Phase 4, wake word only ("Hey CIPHER" hands-free activation). The
# click-to-talk voice loop does NOT need this, and neither does any feature
# built so far. https://console.picovoice.ai asks for a work email on some
# signup flows -- if that stops you, it is not worth working around, because
# there are two keyless ways to get a wake word:
#   1. Match the phrase in the transcript. Recognition is already streaming
#      text continuously (apps/web/src/hooks/useVoice.ts), so "hey cipher"
#      can be detected client-side with no new dependency and no account.
#   2. openWakeWord (MIT, https://github.com/dscripka/openWakeWord) runs a
#      local ONNX model in Python. No signup, no key, fully offline.
# Leave this blank unless you specifically choose Porcupine.
PICOVOICE_ACCESS_KEY=your-picovoice-key

# Phase 5, web search tool. Tavily's free tier is the intended default:
# https://app.tavily.com
# Without it, web search still works via a keyless provider that returns
# encyclopaedic lookups rather than ranked web results.
SEARCH_API_KEY=your-tavily-or-serpapi-key

# ── Phase 7: computer control (OFF by default, and it should stay that way
#    until you have read docs/architecture.md Section 9) ─────────────────
# Nothing in the automation system runs at all unless this is true. A fresh
# clone of this repository cannot act on anyone's machine, which is the only
# safe default for code that opens applications.
AUTOMATION_ENABLED=false
# Directories `list_directory` may read, comma-separated absolute paths.
# Empty means no directory is readable. It reads names only.
AUTOMATION_ALLOWED_DIRS=
# Applications `open_app` may launch, as name=executable pairs.
# e.g. AUTOMATION_ALLOWED_APPS=editor=code,notes=notepad
# `open_app` is a SENSITIVE action: even with a session approval it asks for
# an explicit confirmation every single time.
AUTOMATION_ALLOWED_APPS=


# ── OPTIONAL UPGRADES (all paid -- none required at any phase) ────────────
# The stack is free-tier-first by design (CLAUDE.md). These exist only so
# that swapping a provider stays a config change, not a rewrite.
# OPENAI_API_KEY=            # alternative LLM provider
# ANTHROPIC_API_KEY=         # alternative LLM provider
# ELEVENLABS_API_KEY=        # paid TTS, if browser voices / Edge-TTS aren't enough
# SENTRY_DSN=                # Phase 8 error monitoring
